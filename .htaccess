# Adresses propres : https://www.lejardinparmentier.fr/ (sans index.php), /mentions-legales, /affiche, /carte-traiteur
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Fichiers techniques jamais accessibles depuis le navigateur (Git, réglages, bibliothèques PHP)
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
RewriteRule ^(lib|stats|comptes)\.php$ - [R=404,L]

# Anciennes adresses en .php : redirection définitive vers l'adresse propre
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+mentions\.php[\s?] [NC]
RewriteRule ^ /mentions-legales [R=301,L]
RewriteCond %{THE_REQUEST} \s/+affiche\.php[\s?] [NC]
RewriteRule ^ /affiche [R=301,L]
RewriteCond %{THE_REQUEST} \s/+carte\.php[\s?] [NC]
RewriteRule ^ /carte-traiteur [R=301,L]

# Adresses propres servies par les fichiers PHP
RewriteRule ^(mentions-legales|affiche|carte-traiteur)/$ /$1 [R=301,L]
RewriteRule ^mentions-legales$ mentions.php [L]
RewriteRule ^affiche$ affiche.php [L]
RewriteRule ^carte-traiteur$ carte.php [L]
</IfModule>

# ---- Performance : compression et mise en cache ----
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Les fichiers CSS, JS et photos ont un numéro de version dans leur adresse (?v=…) : on peut les garder un an.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header setifempty Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
